# Browser-visible Supabase configuration only.
# Use the project's publishable/anon key here, NEVER the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase Edge Function URL. This is an endpoint, not a secret.
NEXT_PUBLIC_AI_ENDPOINT=https://YOUR_PROJECT.supabase.co/functions/v1/artha-ai
